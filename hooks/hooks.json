{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/git-commit-no-verify-guard.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protolog-temp-commit-integrity-guard.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protolog-revert-conflict-guard.sh",
            "if": "Bash(git revert*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protolog-revert-conflict-guard.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/replay-temp-commit-integrity-guard.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/replay-revert-conflict-guard.sh",
            "if": "Bash(git revert*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/replay-revert-conflict-guard.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  }
}
